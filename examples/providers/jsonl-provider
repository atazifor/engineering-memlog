#!/usr/bin/env python3
"""Minimal protocol-v1 Memlog provider backed by a configurable JSONL file.

This is an adapter example, not a second built-in storage path. Point
MEMLOG_PROVIDER_FILE at its data file, then set ENGINEERING_MEMLOG_PROVIDER_COMMAND
to this executable. Replace the two storage branches with database, API, or cache
calls to build a provider for another datastore.
"""

import json
import os
import sys
from pathlib import Path


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 2


def main() -> int:
    try:
        request = json.loads(sys.stdin.readline())
    except json.JSONDecodeError as exc:
        return fail(f"invalid request JSON: {exc}")

    if not isinstance(request, dict) or request.get("protocol_version") != 1:
        return fail("unsupported or missing protocol_version")

    raw_path = os.environ.get("MEMLOG_PROVIDER_FILE", "").strip()
    if not raw_path:
        return fail("MEMLOG_PROVIDER_FILE is required")
    store = Path(raw_path).expanduser()

    operation = request.get("operation")
    if operation == "scan":
        if store.exists():
            sys.stdout.write(store.read_text(encoding="utf-8"))
        return 0

    if operation == "append":
        entry = request.get("entry")
        if not isinstance(entry, dict):
            return fail("append requires an entry object")
        store.parent.mkdir(parents=True, exist_ok=True)
        encoded = (json.dumps(entry, ensure_ascii=False) + "\n").encode("utf-8")
        descriptor = os.open(
            str(store), os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600
        )
        try:
            if os.write(descriptor, encoded) != len(encoded):
                return fail("short append")
        finally:
            os.close(descriptor)
        print('{"ok":true}')
        return 0

    return fail(f"unsupported operation: {operation}")


if __name__ == "__main__":
    raise SystemExit(main())
