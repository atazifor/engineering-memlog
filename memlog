#!/usr/bin/env python3
"""
memlog — durable engineering memory for AI coding agents.

A deliberately dumb tool: it appends a structured JSON entry to a single
append-only log, and ranks lexical matches when reading it back. All the
judgment — what is worth logging, and when to search — lives in your agent's
rules file, not here.
See README.md.

Default backend: ~/.engineering-memlog/entries.jsonl
Override per-call:  --file <path>
Override globally:  ENGINEERING_MEMLOG_FILE=<path> in the environment.
Custom provider:    ENGINEERING_MEMLOG_PROVIDER_COMMAND=<command>

Stdlib only — no dependencies. Python 3.8+.
"""
import argparse
import json
import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List

from memlog_provider import ProviderError, append_entry, iter_entries, scan_records
from memlog_retrieval import rank_entries
from memlog_schema import CURRENT_SCHEMA_VERSION, entry_validation_errors

DEFAULT_DATA_FILE = Path(
    os.environ.get(
        "ENGINEERING_MEMLOG_FILE",
        str(Path.home() / ".engineering-memlog" / "entries.jsonl"),
    )
)

def utc_now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_json_payload(raw: str) -> Dict[str, Any]:
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON payload: {exc}") from exc

    if not isinstance(payload, dict):
        raise SystemExit("Payload must be a JSON object.")
    return payload


def positive_int(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive integer") from exc
    if value <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return value


def validate_entry(entry: Dict[str, Any]) -> Dict[str, Any]:
    supplied = [field for field in ("id", "timestamp") if field in entry]
    if supplied:
        names = ", ".join(f"'{field}'" for field in supplied)
        raise SystemExit(
            f"Bookkeeping fields are generated by memlog; do not supply: {names}."
        )

    entry["timestamp"] = utc_now_iso()
    entry["id"] = f"mem-{uuid.uuid4().hex}"
    entry.setdefault("schema_version", CURRENT_SCHEMA_VERSION)

    errors = entry_validation_errors(entry, allow_legacy_schema=False)
    if errors:
        raise SystemExit("Invalid entry: " + " ".join(errors))

    entry["confidence"] = float(entry["confidence"])
    return entry


def print_jsonl(entries: List[Dict[str, Any]]) -> None:
    """Emit entries as JSONL — one JSON object per line, same shape as the
    log file itself. This is the agent-readable output mode."""
    for entry in entries:
        print(json.dumps(entry, ensure_ascii=False))


def meta_line(*pairs: Any) -> str:
    """Render '  key=value key=value' for the human view, dropping any pair
    whose value is empty so a blank field never shows as a bare 'key='."""
    return "  " + " ".join(f"{k}={v}" for k, v in pairs if str(v).strip() != "")


def cmd_add(args: argparse.Namespace) -> int:
    payload = load_json_payload(args.json)
    entry = validate_entry(payload)
    append_entry(entry, Path(args.file))
    print(f"Appended memory entry: {entry['title']}")
    return 0


def cmd_search(args: argparse.Namespace) -> int:
    data_file = Path(args.file)
    entries = iter_entries(data_file)
    matches = [entry for _, entry in rank_entries(entries, [args.query])[: args.limit]]

    if args.json:
        print_jsonl(matches)
        return 0

    if not matches:
        print("No matches found.")
        return 0

    for entry in matches:
        print(f"- {entry.get('timestamp', '')} | {entry.get('title', '')}")
        print(meta_line(("repo", entry.get("repo", "")), ("service", entry.get("service", "")), ("env", entry.get("environment", ""))))
        print(f"  tags={', '.join(entry.get('tags', []))}")
        print(f"  problem={entry.get('problem', '')}")
        print()
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    data_file = Path(args.file)
    entries = list(iter_entries(data_file))
    if args.reverse:
        entries = list(reversed(entries))
    if args.limit:
        entries = entries[: args.limit]

    if args.json:
        print_jsonl(entries)
        return 0

    for entry in entries:
        print(f"- {entry.get('timestamp', '')} | {entry.get('title', '')}")
        print(meta_line(("repo", entry.get("repo", "")), ("confidence", entry.get("confidence", "")), ("status", entry.get("status", ""))))
        print(f"  tags={', '.join(entry.get('tags', []))}")
        print()
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    data_file = Path(args.file)
    valid = 0
    invalid = 0
    errors = []
    seen_ids = set()

    for record in scan_records(data_file, strict_provider=False):
        messages = [record.error] if record.error else []
        entry = record.entry
        if entry is not None:
            messages.extend(entry_validation_errors(entry))
            entry_id = entry.get("id")
            if isinstance(entry_id, str) and entry_id in seen_ids:
                messages.append(f"duplicate id: {entry_id}")
            elif isinstance(entry_id, str):
                seen_ids.add(entry_id)

        if messages:
            invalid += 1
            errors.append({"line": record.position, "message": " ".join(messages)})
        else:
            valid += 1

    report = {"valid": valid, "invalid": invalid, "errors": errors}
    if args.json:
        print(json.dumps(report, ensure_ascii=False))
    else:
        print(f"Valid entries: {valid}")
        print(f"Invalid entries: {invalid}")
        for error in errors:
            print(f"  line {error['line']}: {error['message']}")
    return 1 if invalid else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="memlog",
        description="Durable engineering memory for AI coding agents (single cross-project log).",
    )
    parser.add_argument(
        "--file",
        default=str(DEFAULT_DATA_FILE),
        help=(
            "Path to the JSONL data file. "
            f"Default: {DEFAULT_DATA_FILE} "
            "(or set ENGINEERING_MEMLOG_FILE)."
        ),
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    add_parser = subparsers.add_parser("add", help="Append one JSON entry")
    add_parser.add_argument("--json", required=True, help="JSON object string for the memory entry")
    add_parser.set_defaults(func=cmd_add)

    search_parser = subparsers.add_parser("search", help="Ranked keyword search of entries")
    search_parser.add_argument("query", help="Search text")
    search_parser.add_argument("--limit", type=positive_int, default=10)
    search_parser.add_argument(
        "--json",
        action="store_true",
        help="Emit matching entries as JSONL (one JSON object per line) for agent consumption",
    )
    search_parser.set_defaults(func=cmd_search)

    list_parser = subparsers.add_parser("list", help="List entries")
    list_parser.add_argument("--limit", type=positive_int, default=20)
    list_parser.add_argument("--reverse", action="store_true", help="Show newest first")
    list_parser.add_argument(
        "--json",
        action="store_true",
        help="Emit entries as JSONL (one JSON object per line) for agent consumption",
    )
    list_parser.set_defaults(func=cmd_list)

    validate_parser = subparsers.add_parser(
        "validate",
        help="Check entry schemas and duplicate IDs without changing the log",
    )
    validate_parser.add_argument(
        "--json",
        action="store_true",
        help="Emit one JSON validation report",
    )
    validate_parser.set_defaults(func=cmd_validate)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except (OSError, ProviderError) as exc:
        print(f"Memlog backend unavailable: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
